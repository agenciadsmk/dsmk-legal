msgstr ""

#: includes/class-dsmkc-legal.php:628
#, php-format
msgid "Este aviso legal regula el acceso y el uso de la web %1$s (%2$s)%3$s. Acceder a la web te atribuye la condición de usuario e implica la aceptación de estas condiciones."
msgstr ""

#: includes/class-dsmkc-legal.php:628
