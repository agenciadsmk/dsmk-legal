<?xml version="1.0"?>
<!--
  Reglas de PHP_CodeSniffer para DSMK Legal.
  Instalar: composer install   ·   Ejecutar: composer lint
-->
<ruleset name="DSMK Legal">
	<description>WordPress Coding Standards + compatibilidad PHP 7.4+.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Nombres de archivo de clase con prefijo propio (class-dsmkc-*.php) ya cumplen; se excluye la regla de nombres de hooks con guion. -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dsmk-legal"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dsmkc"/>
				<element value="dsmk_legal"/>
			</property>
		</properties>
	</rule>
</ruleset>
